engine-strict=true
auto-install-peers=true
shamefully-hoist=true
# Wait at least 7 days (npm expresses this setting in days) before npm will
# resolve a newly published package version, to reduce exposure to compromised
# or unstable releases. Mirrors the 7-day window pnpm enforces via
# minimumReleaseAge: 10080 (minutes) in pnpm-workspace.yaml.
min-release-age=7
